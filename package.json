{
  "name": "openwinpatcher",
  "productName": "OpenWinPatcher",
  "version": "1.0.5",
  "description": "Free open-source Windows utility: install apps, tweaks, config and updates.",
  "author": "Sten Pals",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dist": "electron-vite build && electron-builder --win",
    "build:web": "electron-vite build",
    "build": "electron-vite build && electron-builder --win nsis msi --x64",
    "build:nsis": "electron-vite build && electron-builder --win nsis --x64",
    "build:msi": "electron-vite build && electron-builder --win msi --x64",
    "build:all": "electron-vite build && electron-builder --win nsis msi portable --x64",
    "pack": "electron-vite build && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "lucide-react": "^0.400.0",
    "@fontsource/barlow": "^5.2.5",
    "@fontsource/barlow-condensed": "^5.2.5",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.7.0",
     "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
      "electron-vite": "^3.1.0",
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "react-markdown": "^10.1.0",
     "tailwindcss": "^4.1.11",
     "vite": "^6.3.5"

  }
}
